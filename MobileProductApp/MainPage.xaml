<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MobileProductApp.MainPage"
    Title="Products">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Product List"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Button
                Text="Load Products"
                Clicked="LoadProducts_Clicked" />

            <CollectionView
                x:Name="ProductCollectionView">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            StrokeShape="RoundRectangle 10"
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="{Binding ProductName}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Price, StringFormat='Price: ₹{0:F2}'}"
                                    FontSize="16" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>